# Varsayilan: her seyi ignore et, sadece kod/dokuman/metin tabanli dosyalari al.
*

# Dizinleri gezebilmek icin klasorleri acik birak.
!*/

# Kaynak kodu, sablon, stil ve dokuman dosyalari
!*.py
!*.md
!*.txt
!*.html
!*.css
!*.js
!*.json
!*.yml
!*.yaml
!*.toml
!*.ini
!*.cfg
!*.gitignore
!.gitattributes
!.editorconfig
!requirements.txt
!/Dockerfile
!/.dockerignore
!/deploy/nginx/3d-models.perinet.org.conf
!/deploy/renew-certificate.sh
!/deploy/systemd/3d-models-cert-renew.service
!/deploy/systemd/3d-models-cert-renew.timer

# Python/artifact ve yerel durum dosyalari
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Yerel veritabani ve IDE dosyalari
db.json
db.*.json
.admin.json
.secret_key
.server.lock
.idea/
.vscode/

# Uygulamanin urettigi yerel veri (onizleme onbellegi, yarim yuklemeler, cop kutusu)
thumbnails/
.uploads/
.trash/

# Buyuk dosyalar ve 3D model formatlari (push timeout onlemek icin)
*.stl
*.scad
*.obj
*.blend
*.blend1
*.fbx
*.glb
*.gltf
*.3mf
*.dae
*.3ds
*.max
*.ztl
*.mb
*.ma
*.psd
*.xcf
*.exr
*.hdr
*.tga
*.bmp
*.ico
*.wav
*.mp3
*.mp4
*.avi
*.zip
*.rar
*.7z
*.tar
*.gz

# Arayuz yazi tipleri (yukaridaki genel kurallardan sonra gelmeli)
!/static/vendor/fonts/*.woff2
